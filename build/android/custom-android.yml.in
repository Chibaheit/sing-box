# NON-ACTIVE TEMPLATE. Render outside the repository; manually add via GitHub UI.
# Install commit message must include [skip ci] to suppress existing push workflows.
name: Custom Android DEBUG trial

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: custom-android-debug-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    env:
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
      - name: Check out immutable build tooling
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          repository: Chibaheit/sing-box
          ref: '@TOOLING_REVISION@'
          path: tooling
          persist-credentials: false
          sparse-checkout: build/android

      - name: Check out paired core and Android app
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          repository: Chibaheit/sing-box
          ref: 4a39ff496a245e1864cdbe608cab09f5d17df9bc
          path: source
          fetch-depth: 1
          fetch-tags: false
          submodules: false
          persist-credentials: false

      - name: Fetch only the exact paired Android gitlink
        working-directory: source
        run: git submodule update --init --depth 1 clients/android

      - name: Test source patches and artifact rejection cases
        run: >-
          python3 tooling/build/android/test_scripts.py
          --core-source source --app-source source/clients/android -v

      - name: Set up Go
        uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version: '1.26.8'
          check-latest: false
          cache: false

      - name: Set up OpenJDK 17
        uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: '17'

      # Dispatching this workflow accepts the Android SDK/NDK licenses.
      - name: Install SDK command-line tools and accept licenses
        uses: android-actions/setup-android@9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3
        with:
          cmdline-tools-version: '12266719'
          accept-android-sdk-licenses: true
          log-accepted-android-sdk-licenses: false
          packages: ''

      - name: Install pinned Android SDK and NDK packages
        run: >-
          sdkmanager 'platforms;android-37.1' 'platforms;android-36'
          'build-tools;37.0.0' 'ndk;28.0.13004108'

      - name: Build arm64 libbox and OtherDebug APK
        run: bash tooling/build/android/build.sh "$GITHUB_WORKSPACE/source"

      - name: Verify APK and assemble allowlisted provenance artifacts
        run: >-
          python3 tooling/build/android/collect.py
          "$GITHUB_WORKSPACE/source" "$GITHUB_WORKSPACE/tooling"
          "$GITHUB_WORKSPACE/artifacts"

      - name: Upload DEBUG trial and corresponding source snapshots
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: Chibaheit-SFA-1.14.1-chibaheit.1-arm64-v8a-DEBUG
          path: |
            artifacts/*-DEBUG.apk
            artifacts/SHA256SUMS
            artifacts/certificate-sha256.txt
            artifacts/source-manifest.json
            artifacts/source-patch-bundle.tar.gz
            artifacts/core-source.tar.gz
            artifacts/app-source.tar.gz
          if-no-files-found: error
          include-hidden-files: false
          compression-level: 0
          retention-days: 14
